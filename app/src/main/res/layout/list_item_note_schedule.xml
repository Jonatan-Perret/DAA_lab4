<?xml version="1.0" encoding="utf-8"?>
<!-- Item de la liste : note associée à une échéance (Schedule) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- icône du type de note, teintée selon l'état -->
        <ImageView
            android:id="@+id/note_type_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:src="@drawable/work" />

        <TextView
            android:id="@+id/note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/schedule_container"
            app:layout_constraintStart_toEndOf="@id/note_type_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Titre" />

        <TextView
            android:id="@+id/note_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintEnd_toEndOf="@id/note_title"
            app:layout_constraintStart_toStartOf="@id/note_title"
            app:layout_constraintTop_toBottomOf="@id/note_title"
            tools:text="Contenu de la note" />

        <!-- état et date de création -->
        <TextView
            android:id="@+id/note_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            app:layout_constraintEnd_toEndOf="@id/note_title"
            app:layout_constraintStart_toStartOf="@id/note_title"
            app:layout_constraintTop_toBottomOf="@id/note_text"
            tools:text="En cours · créée le 21 nov. 2026, 14:03" />

        <!-- échéance : icône horloge, délai restant (ou retard) et date prévue -->
        <LinearLayout
            android:id="@+id/schedule_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/schedule_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/schedule_icon_description"
                android:src="@drawable/clock" />

            <TextView
                android:id="@+id/schedule_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                tools:text="Dans 12 jours" />

            <TextView
                android:id="@+id/schedule_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="3 déc. 2026" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
