<?xml version="1.0" encoding="utf-8"?>
<!-- Layout tablette en paysage (largeur minimale >= 600dp ET orientation paysage) :
     fragment de contrôle (compteur + boutons) à gauche, liste des notes à droite -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/controls_fragment"
        android:name="ch.heigvd.iict.daa.template.ui.ControlsFragment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="1dp"
        android:layout_height="match_parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/notes_list_fragment"
        android:name="ch.heigvd.iict.daa.template.ui.NotesListFragment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2" />

</LinearLayout>
